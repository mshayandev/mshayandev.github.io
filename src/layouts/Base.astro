---
import "../styles/global.css";
import Loader from "../components/Loader.astro";
import { profile } from "../data/profile";

export interface Props {
  title?: string;
  description?: string;
  /** Path for canonical URL, e.g. "/" or "/projects/sharc/" */
  path?: string;
  image?: string;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = "Portfolio of Mohammad Shayan — IoT & embedded systems, full-stack web, and AI for wireless communications. Karachi, Pakistan.",
  path = "/",
  image = profile.portrait,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://mshayandev.github.io";
const canonical = `${site}${path}`;
const ogImage = image.startsWith("http") ? image : `${site}${image}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: site + "/",
  jobTitle: "IoT Engineer and Full-Stack Developer",
  email: `mailto:${profile.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Karachi",
    addressCountry: "PK",
  },
  sameAs: [profile.socials.github, profile.socials.linkedin, profile.socials.instagram],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-EF37C2T943"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-EF37C2T943");
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Runs before paint: decides whether the intro curtain shows at all. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let seen = false;
        try {
          seen = !!sessionStorage.getItem("ms:visited");
        } catch {}
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (seen || still) root.classList.add("no-loader");
        else root.classList.add("is-loading");
        // Safety net: if the motion scripts never run, show the content anyway.
        setTimeout(() => root.classList.add("motion-fallback"), 4000);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0a0e16" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mohammad Shayan Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" href="/assets/img/shayantitle.png" />
    <link rel="apple-touch-icon" href="/assets/img/shayantitle.png" />

    <!-- Fonts: Space Grotesk (display) · Inter (body) · JetBrains Mono (accents) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-ink text-fg">
    <Loader />
    <div class="bg-grid pointer-events-none fixed inset-0 -z-10"></div>
    <slot />

    <!-- Scroll reveal: progressive enhancement only -->
    <script is:inline>
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
