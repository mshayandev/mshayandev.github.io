---
import { profile } from "../data/profile";
import Socials from "./Socials.astro";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

<section id="contact" class="scroll-mt-20 border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading
      kicker="06 — Contact"
      title="Let's build something"
      lead="Got a project, an idea, or a role in mind? The fastest way to reach me is email or LinkedIn."
    />

    <div class="grid gap-6 md:grid-cols-[1.2fr_1fr]" data-reveal>
      <div class="rounded-xl border border-border bg-surface p-8">
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent-2">
          <Icon name="mail" size={14} />
          Email
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-2 block break-all text-xl font-semibold text-fg hover:text-accent"
        >
          {profile.email}
        </a>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`mailto:${profile.email}`}
            class="btn-glow inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 font-mono text-sm font-medium text-ink"
          >
            <Icon name="send" size={15} />
            Send an email
          </a>
          <a
            href={profile.socials.linkedin}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-md border border-border px-6 py-3 font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name="linkedin" size={15} />
            Message on LinkedIn
          </a>
        </div>
      </div>

      <div class="flex flex-col justify-between rounded-xl border border-border bg-surface p-8">
        <div>
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-accent-2">
            <Icon name="pin" size={14} />
            Based in
          </p>
          <p class="mt-2 text-lg text-fg">{profile.location}</p>
          <p class="mt-1 text-sm text-muted">Open to freelance & full-time opportunities.</p>
        </div>
        <div class="mt-6">
          <p class="mb-3 font-mono text-xs uppercase tracking-widest text-accent-2">Elsewhere</p>
          <Socials />
        </div>
      </div>
    </div>
  </div>
</section>
