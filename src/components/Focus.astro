---
import { focusAreas } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

<section class="border-t border-border/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeading
      kicker="02 — What I do"
      title="Three things I keep coming back to"
      lead="No service menu — just the work I actually do and enjoy."
    />

    <div class="grid gap-6 md:grid-cols-3">
      {
        focusAreas.map((f) => (
          <div
            class="group rounded-xl border border-border bg-surface p-7 transition-colors hover:border-accent/60"
            data-reveal
          >
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg border border-border bg-surface-2 text-accent transition-colors group-hover:border-accent/50 group-hover:text-accent-2">
              <Icon name={f.icon} size={22} />
            </div>
            <h3 class="text-xl font-semibold">{f.title}</h3>
            <p class="mt-3 text-muted">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
