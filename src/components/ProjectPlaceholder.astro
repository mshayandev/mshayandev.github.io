---
import { generateThumbnail, type ThumbCategory } from "../lib/thumbnail";

/**
 * Generative stand-in for projects with no screenshot. Rendered at build time
 * and seeded by the slug, so each project gets its own permanent artwork.
 * Drop a real `image` on the project and this disappears.
 */
interface Props {
  seed: string;
  category: ThumbCategory;
  class?: string;
}

const { seed, category, class: cls = "" } = Astro.props;
const { viewBox, markup } = generateThumbnail(seed, category);
---

<div class={`thumb relative h-full w-full overflow-hidden bg-surface-2 ${cls}`}>
  <svg
    class="h-full w-full"
    viewBox={viewBox}
    preserveAspectRatio="xMidYMid slice"
    role="presentation"
    aria-hidden="true"
    set:html={markup}
  />
  <div class="thumb-sheen pointer-events-none absolute inset-0"></div>
</div>

<style>
  .thumb-sheen {
    background: linear-gradient(
      104deg,
      transparent 38%,
      rgba(255, 255, 255, 0.055) 50%,
      transparent 62%
    );
    background-size: 260% 100%;
    animation: thumb-sheen 7s ease-in-out infinite;
  }

  @keyframes thumb-sheen {
    0%,
    100% {
      background-position: 130% 0;
    }
    50% {
      background-position: -30% 0;
    }
  }

  /* Pulses travel the hot traces / chart line while the card is hovered. */
  .thumb :global(.thumb-flow) {
    stroke-dasharray: 26 620;
    stroke-dashoffset: 646;
    opacity: 0.85;
  }

  :global(.group:hover) .thumb :global(.thumb-flow),
  .thumb:hover :global(.thumb-flow) {
    animation: thumb-flow 2.6s linear infinite;
    opacity: 1;
  }

  @keyframes thumb-flow {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb-sheen {
      animation: none;
    }
    :global(.group:hover) .thumb :global(.thumb-flow),
    .thumb:hover :global(.thumb-flow) {
      animation: none;
    }
  }
</style>
