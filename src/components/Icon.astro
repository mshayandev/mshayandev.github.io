---
/**
 * Single inline SVG sprite source. Stroke-based, 24×24, currentColor —
 * so icons inherit text colour and hover states like any other glyph.
 */
export type IconName = "chip" | "code" | "signal" | "award" | "arrow-right" | "arrow-left" | "arrow-up-right" | "download" | "chevron" | "mail" | "pin" | "send" | "github" | "linkedin" | "menu" | "close";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { name, class: cls = "", size = 20, strokeWidth = 1.7 } = Astro.props;

const paths: Record<IconName, string> = {
  chip: `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>`,
  code: `<path d="m8 6-6 6 6 6M16 6l6 6-6 6M13.5 4l-3 16"/>`,
  signal: `<path d="M4.9 19.1a10 10 0 0 1 0-14.2M19.1 4.9a10 10 0 0 1 0 14.2M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4"/><circle cx="12" cy="12" r="1.6"/>`,
  award: `<circle cx="12" cy="9" r="5.5"/><path d="M8.2 13.6 7 22l5-2.6L17 22l-1.2-8.4"/>`,
  "arrow-right": `<path d="M4 12h15M13 6l6 6-6 6"/>`,
  "arrow-left": `<path d="M20 12H5M11 6l-6 6 6 6"/>`,
  "arrow-up-right": `<path d="M7 17 17 7M8 7h9v9"/>`,
  download: `<path d="M12 3v12M7 11l5 5 5-5M4 20h16"/>`,
  chevron: `<path d="m9 5 7 7-7 7"/>`,
  mail: `<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>`,
  pin: `<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>`,
  send: `<path d="M21 3 10.5 13.5M21 3l-6.8 18-3.7-7.5L3 9.8 21 3Z"/>`,
  github: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19.9 5a4.9 4.9 0 0 0-.1-3.6s-1.2-.3-3.9 1.5a13.4 13.4 0 0 0-7 0C6.2 1.1 5 1.4 5 1.4A4.9 4.9 0 0 0 4.9 5 5.2 5.2 0 0 0 3.5 8.8c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22"/>`,
  linkedin: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>`,
  menu: `<path d="M3 6h18M3 12h18M3 18h18"/>`,
  close: `<path d="M6 6l12 12M18 6 6 18"/>`,
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
