---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";

const links = [
  { label: "About", href: "/#about" },
  { label: "Work", href: "/#work" },
  { label: "Résumé", href: "/#resume" },
  { label: "Contact", href: "/#contact" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-ink/70 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a
      href="/"
      class="font-display text-lg font-bold tracking-tight text-fg hover:text-accent"
    >
      Mohammad<span class="text-accent">.</span>Shayan
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="font-mono text-sm text-muted transition-colors hover:text-fg"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-accent/40 bg-accent/10 px-4 py-2 font-mono text-sm text-accent transition-colors hover:bg-accent hover:text-ink"
        >
          Résumé
        </a>
      </li>
    </ul>

    <button
      id="nav-toggle"
      class="text-fg md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="menu" size={26} strokeWidth={1.9} class="nav-icon-menu" />
      <Icon name="close" size={26} strokeWidth={1.9} class="nav-icon-close hidden" />
    </button>
  </nav>

  <div id="nav-menu" class="hidden border-t border-border/60 md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-3">
      {
        [...links, { label: "Résumé", href: profile.resume }].map((l) => (
          <li>
            <a
              href={l.href}
              class="block py-3 font-mono text-sm text-muted hover:text-fg"
              data-nav-link
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (!btn || !menu) return;
    const iconMenu = btn.querySelector(".nav-icon-menu");
    const iconClose = btn.querySelector(".nav-icon-close");
    const sync = (open) => {
      btn.setAttribute("aria-expanded", String(open));
      iconMenu?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };
    const close = () => {
      menu.classList.add("hidden");
      sync(false);
    };
    btn.addEventListener("click", () => {
      sync(!menu.classList.toggle("hidden"));
    });
    menu.querySelectorAll("[data-nav-link]").forEach((a) => a.addEventListener("click", close));
  })();
</script>
