---
import { profile } from "../data/profile";
const year = 2026;
---

<footer class="border-t border-border/60 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-sm text-muted sm:flex-row">
    <p>© {year} {profile.name}</p>
    <p class="font-mono text-xs">
      Built with Astro &amp; Tailwind · {profile.location}
    </p>
  </div>
</footer>
