---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<div class="mb-10 max-w-2xl md:mb-14" data-reveal>
  {kicker && <p class="kicker mb-3">{kicker}</p>}
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-muted">{lead}</p>}
</div>
