---
import { profile } from "../data/profile";

/**
 * Intro curtain. Its three status lines mirror the three stages of the
 * WebGL backdrop — board, link, interface — so the load reads as the system
 * coming up rather than as a spinner.
 *
 * Skipped entirely on reduced motion and on repeat visits within a session.
 */
const initials = profile.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<div id="loader" aria-hidden="true">
  <div class="loader-inner">
    <div class="loader-mark" data-loader-mark>
      {initials.split("").map((c) => <span>{c}</span>)}
    </div>

    <div class="loader-bar"><i data-loader-fill></i></div>

    <div class="loader-meta">
      <span data-loader-status>Powering board</span>
      <span data-loader-pct>00</span>
    </div>
  </div>
</div>

<script>
  import { initMotion, reducedMotion, markSiteReady } from "../lib/motion";

  const loader = document.getElementById("loader");
  const root = document.documentElement;

  const finish = () => {
    loader?.remove();
    root.classList.remove("is-loading");
    markSiteReady();
  };

  if (!loader) {
    markSiteReady();
  } else if (reducedMotion() || root.classList.contains("no-loader")) {
    finish();
  } else {
    const { gsap } = initMotion();
    const fill = loader.querySelector<HTMLElement>("[data-loader-fill]");
    const pct = loader.querySelector<HTMLElement>("[data-loader-pct]");
    const status = loader.querySelector<HTMLElement>("[data-loader-status]");
    const marks = loader.querySelectorAll<HTMLElement>("[data-loader-mark] span");

    try {
      sessionStorage.setItem("ms:visited", "1");
    } catch {
      /* private mode — the loader simply shows every time */
    }

    const stages = ["Powering board", "Linking devices", "Rendering interface"];
    const counter = { value: 0 };
    let loaded = false;
    window.addEventListener("load", () => (loaded = true), { once: true });

    const tl = gsap.timeline({ defaults: { ease: "power2.out" } });

    tl.from(marks, { yPercent: 110, opacity: 0, duration: 0.6, stagger: 0.08 })
      .to(
        counter,
        {
          // Runs to 92 while assets load, then completes below.
          value: 92,
          duration: 1.15,
          ease: "power1.inOut",
          onUpdate: () => {
            const v = Math.round(counter.value);
            if (pct) pct.textContent = String(v).padStart(2, "0");
            if (fill) fill.style.transform = `scaleX(${counter.value / 100})`;
            const next = stages[Math.min(2, Math.floor(v / 34))];
            if (status && status.textContent !== next) status.textContent = next;
          },
        },
        "-=0.35"
      )
      // Hold at 92 until the page has actually loaded (capped, so it never hangs).
      .to({}, { duration: 0.01, onComplete: waitForLoad });

    function waitForLoad() {
      const started = performance.now();
      const poll = () => {
        if (loaded || performance.now() - started > 1400) complete();
        else requestAnimationFrame(poll);
      };
      poll();
    }

    function complete() {
      gsap
        .timeline({ defaults: { ease: "power3.inOut" }, onComplete: finish })
        .to(counter, {
          value: 100,
          duration: 0.35,
          onUpdate: () => {
            if (pct) pct.textContent = String(Math.round(counter.value));
            if (fill) fill.style.transform = `scaleX(${counter.value / 100})`;
          },
        })
        .call(() => {
          if (status) status.textContent = "Ready";
        })
        .to(".loader-inner", { opacity: 0, y: -14, duration: 0.4 }, "+=0.15")
        .to(
          loader,
          { clipPath: "inset(0 0 100% 0)", duration: 0.9, ease: "power4.inOut" },
          "-=0.15"
        );
    }
  }
</script>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--color-ink, #0a0e16);
    clip-path: inset(0 0 0 0);
    will-change: clip-path;
  }

  /* Faint board grid so the curtain matches the site, not a blank screen. */
  #loader::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(60% 60% at 50% 50%, #000, transparent 100%);
  }

  .loader-inner {
    position: relative;
    width: min(280px, 72vw);
  }

  .loader-mark {
    display: flex;
    gap: 0.1em;
    overflow: hidden;
    font-family: var(--font-display, sans-serif);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-fg, #e8edf4);
  }
  .loader-mark span {
    display: inline-block;
  }
  .loader-mark span:last-child {
    color: var(--color-accent, #5b8cff);
  }

  .loader-bar {
    margin-top: 1.4rem;
    height: 2px;
    width: 100%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.09);
  }
  .loader-bar i {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      90deg,
      var(--color-accent, #5b8cff),
      var(--color-accent-2, #2dd4bf)
    );
  }

  .loader-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted, #93a1b5);
  }

  @media (prefers-reduced-motion: reduce) {
    #loader {
      display: none;
    }
  }
</style>
