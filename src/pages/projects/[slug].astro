---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ProjectPlaceholder from "../../components/ProjectPlaceholder.astro";
import Icon from "../../components/Icon.astro";
import { projects, categoryLabels } from "../../data/projects";

export function getStaticPaths() {
  return projects
    .filter((p) => p.hasDetail !== false)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const meta = [
  { k: "Domain", v: project.domain },
  project.status ? { k: "Status", v: project.status } : null,
  project.org ? { k: "Organization", v: project.org } : null,
  project.role ? { k: "Role", v: project.role } : null,
].filter(Boolean) as { k: string; v: string }[];
---

<Base
  title={`${project.title} | Mohammad Shayan`}
  description={project.summary}
  path={`/projects/${project.slug}/`}
  image={project.image ?? "/assets/img/cvpic.webp"}
>
  <Nav />
  <main class="mx-auto max-w-5xl px-5 py-16 md:py-20">
    <a
      href="/#work"
      class="link-back inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-fg"
    >
      <Icon name="arrow-left" size={15} class="arrow" />
      Back to work
    </a>

    <header class="mt-6">
      <p class="kicker mb-3">{categoryLabels[project.category]} · {project.domain}</p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{project.title}</h1>
      {
        project.award && (
          <p class="mt-3 inline-flex items-center gap-2 rounded-md border border-accent-2/40 bg-accent-2/10 px-3 py-1 font-mono text-sm text-accent-2">
            <Icon name="award" size={15} />
            {project.award}
          </p>
        )
      }
    </header>

    <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface">
      {
        project.image ? (
          <img src={project.image} alt={project.title} class="w-full object-cover" />
        ) : (
          <div class="aspect-[16/9]">
            <ProjectPlaceholder label={project.title} sub={project.domain} />
          </div>
        )
      }
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-[1.6fr_1fr]">
      <div class="space-y-5 text-lg text-muted">
        {project.description.map((p) => <p>{p}</p>)}

        {
          project.highlights && project.highlights.length > 0 && (
            <div class="pt-2">
              <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-accent-2">
                Highlights
              </h2>
              <ul class="space-y-2">
                {project.highlights.map((h) => (
                  <li class="flex gap-3 text-base text-fg/90">
                    <Icon name="chevron" size={16} class="mt-1 shrink-0 text-accent" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-border bg-surface p-6">
          <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-accent-2">
            Project info
          </h2>
          <dl class="space-y-3 text-sm">
            {
              meta.map((m) => (
                <div>
                  <dt class="text-muted">{m.k}</dt>
                  <dd class="text-fg">{m.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="rounded-xl border border-border bg-surface p-6">
          <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-accent-2">
            Built with
          </h2>
          <ul class="flex flex-wrap gap-2">
            {
              project.tech.map((t) => (
                <li class="rounded-md border border-border bg-surface-2 px-3 py-1 font-mono text-xs text-muted">
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        {
          (project.url || project.repo) && (
            <div class="flex flex-col gap-3">
              {project.url && (
                <a
                  href={project.url.href}
                  target="_blank"
                  rel="noopener"
                  class="btn-glow inline-flex items-center justify-center gap-2 rounded-md bg-accent px-5 py-3 text-center font-mono text-sm font-medium text-ink"
                >
                  Visit {project.url.label}
                  <Icon name="arrow-up-right" size={15} />
                </a>
              )}
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center justify-center gap-2 rounded-md border border-border px-5 py-3 text-center font-mono text-sm text-fg transition-colors hover:border-accent hover:text-accent"
                >
                  <Icon name="github" size={15} />
                  View source code
                </a>
              )}
            </div>
          )
        }
      </aside>
    </div>
  </main>
  <Footer />
</Base>
